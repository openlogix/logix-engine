{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.openlogix.org/schemas/logix-board-v1.json",
  "title": "Logix Catalog board",
  "description": "One board of Logix Catalog (github.com/openlogix/logix-catalog): its file, boards/<id>.json.",
  "$ref": "#/$defs/BoardFields",
  "properties": {
    "$schema": {
      "const": "https://www.openlogix.org/schemas/logix-board-v1.json"
    }
  },
  "required": [
    "$schema"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "Pin": {
      "type": "string",
      "pattern": "^[^\\s\";]+$",
      "description": "An FPGA pin as the board's pin files name it, such as 49 or N14."
    },
    "IoStandard": {
      "enum": [
        "LVCMOS33",
        "LVCMOS25",
        "LVCMOS18",
        "LVCMOS15",
        "LVCMOS12",
        "LVTTL",
        "LVDS",
        "SSTL15",
        "SSTL135"
      ],
      "description": "The pins' I/O standard, one common name for every FPGA family; each pin file writer translates it. Not used on iCE40."
    },
    "Source": {
      "type": "object",
      "description": "Where the facts come from.",
      "properties": {
        "kind": {
          "enum": [
            "hardware",
            "schematic",
            "maker",
            "litex",
            "amaranth",
            "user"
          ]
        },
        "ref": {
          "type": "string",
          "description": "The document, file and commit, or report."
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "AiHints": {
      "type": "array",
      "description": "Hints for AI, and people, writing designs that use the board or resource: only what its structured fields can't express. One line each, at most 90 characters, so each fits on one line of the file. Always the entity's last field.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 90,
        "pattern": "^[^\\n\\r]*$"
      },
      "minItems": 1
    },
    "Clock": {
      "type": "object",
      "description": "An oscillator wired to one FPGA pin.",
      "properties": {
        "type": {
          "const": "clock"
        },
        "pin": {
          "$ref": "#/$defs/Pin"
        },
        "mhz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Its frequency in MHz."
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "pin",
        "mhz"
      ],
      "additionalProperties": false
    },
    "Leds": {
      "type": "object",
      "description": "LEDs, one pin each. One pin gives a plain port, several a vector, bit 0 first.",
      "properties": {
        "type": {
          "const": "leds"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 1
        },
        "active": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The logic level that turns it on. Left out when not known."
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "pins"
      ],
      "additionalProperties": false
    },
    "RgbLed": {
      "type": "object",
      "description": "One RGB LED: a pin per color.",
      "properties": {
        "type": {
          "const": "rgb_led"
        },
        "red": {
          "$ref": "#/$defs/Pin"
        },
        "green": {
          "$ref": "#/$defs/Pin"
        },
        "blue": {
          "$ref": "#/$defs/Pin"
        },
        "active": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The logic level that turns it on. Left out when not known."
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "red",
        "green",
        "blue"
      ],
      "additionalProperties": false
    },
    "LedMatrix": {
      "type": "object",
      "description": "RGB LEDs in a matrix: a pin per LED, and a pin per color; an LED lights when its pin and a color's pin are both active.",
      "properties": {
        "type": {
          "const": "led_matrix"
        },
        "leds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 1
        },
        "colors": {
          "type": "object",
          "properties": {
            "red": {
              "$ref": "#/$defs/Pin"
            },
            "green": {
              "$ref": "#/$defs/Pin"
            },
            "blue": {
              "$ref": "#/$defs/Pin"
            }
          },
          "required": [
            "red",
            "green",
            "blue"
          ],
          "additionalProperties": false
        },
        "active": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The logic level that turns it on. Left out when not known."
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "leds",
        "colors"
      ],
      "additionalProperties": false
    },
    "Buttons": {
      "type": "object",
      "description": "Push buttons, one pin each.",
      "properties": {
        "type": {
          "const": "buttons"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 1
        },
        "active": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The logic level that turns it on. Left out when not known."
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "pins"
      ],
      "additionalProperties": false
    },
    "Switches": {
      "type": "object",
      "description": "Switches, one pin each.",
      "properties": {
        "type": {
          "const": "switches"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 1
        },
        "active": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The logic level that turns it on. Left out when not known."
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "pins"
      ],
      "additionalProperties": false
    },
    "Uart": {
      "type": "object",
      "description": "A serial port, as the FPGA sees it: tx is the FPGA's output.",
      "properties": {
        "type": {
          "const": "uart"
        },
        "tx": {
          "$ref": "#/$defs/Pin"
        },
        "rx": {
          "$ref": "#/$defs/Pin"
        },
        "rts": {
          "$ref": "#/$defs/Pin"
        },
        "cts": {
          "$ref": "#/$defs/Pin"
        },
        "usb_interface": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "The USB interface that carries this serial port on the board's USB device (the one its variants' usb filters match), when that device has several interfaces, such as 1 for an FTDI chip's second channel. Lets tools open the right serial port. Omitted when unknown."
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "tx",
        "rx"
      ],
      "additionalProperties": false
    },
    "Pmod": {
      "type": "object",
      "description": "A PMOD header: its 8 signal pins in header order, 1 to 4 then 7 to 10.",
      "properties": {
        "type": {
          "const": "pmod"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "pins"
      ],
      "additionalProperties": false
    },
    "Header": {
      "type": "object",
      "description": "Any other header: every position in order, null for power and ground.",
      "properties": {
        "type": {
          "const": "header"
        },
        "pins": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Pin"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 1
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "pins"
      ],
      "additionalProperties": false
    },
    "Unclassified": {
      "type": "object",
      "description": "Every FPGA pin the board wires to something no other resource describes; FPGA pins wired to nothing are left out. A board with one lists all its wired pins.",
      "properties": {
        "type": {
          "const": "unclassified"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 1
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "user_notes": {
          "type": "string",
          "description": "Warnings and missing information for users, such as a step the board needs before programming."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints"
        }
      },
      "required": [
        "type",
        "pins"
      ],
      "additionalProperties": false
    },
    "Drive": {
      "type": "object",
      "description": "Pins a design must drive to a level, as a port of its own: a design that uses what the requirement belongs to (the board, or the resource) includes it.",
      "properties": {
        "type": {
          "const": "drive"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "The port name, a Verilog identifier, unique on the board among resources and other drives."
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 1,
          "description": "The FPGA pins, bit 0 first."
        },
        "level": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The level to drive the pins to."
        },
        "io_standard": {
          "$ref": "#/$defs/IoStandard"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "description": "Why, for people."
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "type",
        "name",
        "pins",
        "level"
      ],
      "additionalProperties": false
    },
    "Setup": {
      "type": "object",
      "description": "Something a person must do to the hardware, such as closing a jumper. Generators leave out what needs a setup, so designs work on the board as shipped.",
      "properties": {
        "type": {
          "const": "setup"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "What to do, for people."
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "Requires": {
      "type": "array",
      "description": "What must be done for the board, or the resource, to work: drive pins (the design) or a setup (a person).",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Drive"
          },
          {
            "$ref": "#/$defs/Setup"
          }
        ]
      },
      "minItems": 1
    },
    "Resource": {
      "oneOf": [
        {
          "$ref": "#/$defs/Clock"
        },
        {
          "$ref": "#/$defs/Leds"
        },
        {
          "$ref": "#/$defs/RgbLed"
        },
        {
          "$ref": "#/$defs/LedMatrix"
        },
        {
          "$ref": "#/$defs/Buttons"
        },
        {
          "$ref": "#/$defs/Switches"
        },
        {
          "$ref": "#/$defs/Uart"
        },
        {
          "$ref": "#/$defs/Pmod"
        },
        {
          "$ref": "#/$defs/Header"
        },
        {
          "$ref": "#/$defs/Unclassified"
        }
      ]
    },
    "Selector": {
      "type": "object",
      "description": "Which variant: a value of each standard dimension.",
      "properties": {
        "connection": {
          "enum": [
            "usb",
            "bootloader",
            "ft2232h",
            "ft232h",
            "cmsis-dap",
            "usb-blaster",
            "unspecified"
          ]
        },
        "memory": {
          "enum": [
            "flash",
            "ram"
          ]
        }
      },
      "required": [
        "connection",
        "memory"
      ],
      "additionalProperties": false
    },
    "Usb": {
      "type": "object",
      "description": "The USB device the board is programmed through. How tools match devices to boards is their own.",
      "properties": {
        "vid": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}$"
        },
        "pid": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}$"
        },
        "product_regex": {
          "type": "string"
        },
        "release": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}$"
        },
        "serial_regex": {
          "type": "string"
        }
      },
      "required": [
        "vid",
        "pid"
      ],
      "additionalProperties": false
    },
    "Variant": {
      "type": "object",
      "description": "One way to program the board. The first is the default.",
      "properties": {
        "selector": {
          "$ref": "#/$defs/Selector"
        },
        "programmer": {
          "enum": [
            "openfpgaloader",
            "iceprog",
            "dfu-util",
            "icesprog"
          ]
        },
        "args": {
          "type": "string",
          "description": "The programmer's arguments, a template with ${VID}, ${PID}, ${BUS}, ${DEV}, ${SERIAL_NUM}, ${USB_PATH} and ${BITSTREAM}."
        },
        "usb": {
          "$ref": "#/$defs/Usb"
        },
        "tested": {
          "type": "boolean"
        },
        "user_notes": {
          "type": "string"
        },
        "maintainer_notes": {
          "type": "string"
        }
      },
      "required": [
        "selector",
        "programmer",
        "args",
        "usb",
        "tested"
      ],
      "additionalProperties": false
    },
    "BoardFields": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The board's name for people."
        },
        "fpga_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "The board's FPGA, an ID from the catalog's fpgas/ files."
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variant"
          },
          "minItems": 1
        },
        "resources": {
          "type": "object",
          "description": "What the board wires to FPGA pins, by port name.",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Resource"
          }
        },
        "requires": {
          "$ref": "#/$defs/Requires",
          "description": "What every design for the board must do, such as driving a pin that would otherwise reset the FPGA."
        },
        "ai_hints": {
          "$ref": "#/$defs/AiHints",
          "description": "Hints for the board as a whole."
        }
      },
      "required": [
        "name",
        "fpga_id",
        "variants"
      ]
    },
    "Board": {
      "title": "Board",
      "description": "A board, the same in its catalog file and in a custom boards file.",
      "$ref": "#/$defs/BoardFields",
      "unevaluatedProperties": false
    }
  }
}
