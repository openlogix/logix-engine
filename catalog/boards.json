  "source": "Logix Engine catalog. First imported from Apio's definitions 2026-10-26 and oss-cad-suite 2026-10-22 packages; maintained here since.",
  "boards": {
    "alchitry-cu": {
      "description": "Alchitry Cu Development Board",
      "fpga_id": "ice40hx8k-cb132",
      "default_variant": "flash",
      "variants": {
        "flash": {
          "programmer": "iceprog",
          "args": "-d d:${BUS}/${DEV} ${BITSTREAM}",
          "usb": {
            "vid": "0403",
            "pid": "6010",
            "product_regex": "^Alchitry Cu"
          }
        }
      }
    },
    "alhambra-ii": {
      "description": "Alhambra II",
      "fpga_id": "ice40hx4k-tq144-8k",
      "default_variant": "flash",
      "variants": {
        "flash": {
          "programmer": "openfpgaloader",
          "args": "--force-terminal-mode --verify -b ice40_generic --vid ${VID} --pid ${PID} --busdev-num ${BUS}:${DEV} ${BITSTREAM}",
          "usb": {
            "vid": "0403",
            "pid": "6010",
            "product_regex": "^Alhambra II.*"
          }
        }
      }
    },
