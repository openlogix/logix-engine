{
  "$schema": "https://www.openlogix.org/schemas/logix-board-v1.json",
  "name": "Alhambra II",
  "fpga_id": "ice40hx4k-tq144-8k",
  "variants": [
    {
      "selector": {"connection": "usb", "memory": "flash"},
      "programmer": "openfpgaloader",
      "args": "--force-terminal-mode --verify -b ice40_generic --vid ${VID} --pid ${PID} --busdev-num ${BUS}:${DEV} ${BITSTREAM}",
      "usb": {"vid": "0403", "pid": "6010", "product_regex": "^Alhambra II.*"},
      "tested": true
    }
  ],
  "resources": {
    "sys_clk": {"type": "clock", "pin": "49", "mhz": 12},
    "leds": {
      "type": "leds",
      "pins": ["45", "44", "43", "42", "41", "39", "38", "37"],
      "active": "high"
    },
    "uart": {
      "type": "uart",
      "tx": "61",
      "rx": "62",
      "usb_interface": 1,
      "source": {
        "kind": "maker",
        "ref": "github.com/FPGAwars/Alhambra-II-FPGA examples/picorv32/picosoc/demo.pcf"
      },
      "user_notes": "The FTDI chip's second channel, USB interface 1, over the board's USB cable: computers list two serial ports for the board, and this is the one for interface 1 (interface 0 programs the board)."
    }
  }
}
