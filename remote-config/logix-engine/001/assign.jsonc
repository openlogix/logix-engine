// Assigns Logix Engine's releases to channels, for config version 001
// (Remote updates, in the website repo's CLAUDE.md). A release listed under a
// channel reads that channel's file here, <channel>-channel.jsonc
// (prod-channel.jsonc when it has none); every other release is on dev, the
// default, and local builds always are. Change it only by pull request:
// adding a release under prod promotes it (it must be stable first; then set
// latest in prod-channel.jsonc of the newest config version too).
{
  "$schema": "https://www.openlogix.org/schemas/logix-assign-v1.json",

  // The first promotion, 2026-11-13.
  // 2026-11-16: Windows (Milestone 3) and the version tree (2026-11-15).
  // 2026-11-18: Linux (Milestone 4), with udev rules for boards.
  // 2026-11-21: the waveform viewer in place of GTKWave (Milestone 5:
  // simulate's viewer, open_waveform), the serial tools (Logix IDE's Serial
  // Monitor), the new remote config files with latest, and check_updates'
  // newer_engine.
  // 2026-11-24: the public launch (Milestone 6): Logix Viewer's own windows
  // for waveforms and diagrams, places in the hover boxes, the diagram's web
  // viewer, download_packages' check_only for AI agents, and tool output on
  // Windows.
  // 2026-11-25: the waveform viewer's formats (Binary, Hex, ASCII, Decimal,
  // Analog, with Signed) and the Adaptive scale for analog lines.
  "prod": ["2026-11-12", "2026-11-15", "2026-11-17", "2026-11-21", "2026-11-24", "2026-11-25"]
}
