// What Logix Engine on config 001 uses on the dev channel: engine releases
// assign.jsonc doesn't list (the daily pre-releases, and local builds).
// Deleted at the next promotion, when prod catches up. Change it only by
// pull request, saying why in a comment.
{
  "$schema": "https://www.openlogix.org/schemas/logix-remote-config-v1.json",
  // The newest engine pre-release: a dev release (CI checks it isn't on
  // prod), never older than prod's latest (the janitor checks it), so it
  // moves past each promotion. 2026-11-25: the day after the launch's
  // 2026-11-24.
  "latest": {
    "repo": "openlogix/logix-engine",
    "release": "2026-11-25",
    "file": "logix-engine-${PLATFORM}-${YYYYMMDD}.tgz"
  },
  "dependencies": {
    // Since 2026-11-22, both packages are newest: dev follows each day's
    // pre-release without repinning (the user's decision; read by the engine
    // since logix-engine#70). latest still names a tag.
    // 2026-11-22: Logix Viewer (logix-core#2, #3), the apps the engine
    // shows its pages in (Logix Waveforms, Logix Diagrams), for
    // logix-engine#60.
    "logix-core": {
      "repo": "openlogix/logix-core",
      "release": "newest",
      "file": "logix-core-${PLATFORM}-${YYYYMMDD}.tgz"
    },
    // 2026-11-22: the Soan-Papdi's status LEDs, slide switches, PROG
    // button and IO headers (logix-catalog#4).
    "logix-catalog": {
      "repo": "openlogix/logix-catalog",
      "release": "newest",
      "file": "logix-catalog-${YYYYMMDD}.tgz"
    }
  }
}
