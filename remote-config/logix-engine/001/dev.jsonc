// What Logix Engine on config 001 uses on the dev channel (Remote updates, in
// the website repo's CLAUDE.md): every engine release that isn't promoted, and
// local builds, while this file exists; without it they use prod.jsonc. Every
// such engine reads this file from main, so a change here reaches them
// without an engine release, and never reaches prod. Change it only by pull
// request, saying why in a comment; the tests run with what it names. It may
// name pre-releases: a release a config names is kept. Delete it once a
// promotion has caught prod.jsonc up.
{
  "$schema": "https://www.openlogix.org/schemas/logix-remote-config-v1.json",

  // The FPGA tools: the same as prod's.
  "logix-core": {
    "repo": "openlogix/logix-core",
    "release": "2026-11-15",
    "file": "logix-core-${PLATFORM}-${YYYYMMDD}.tgz"
  },

  // The boards and FPGAs.
  // 2026-11-19: the UART of the Alhambra II, iCESugar Pro, Tang Nano 9K and
  // Arty A7-35T (logix-catalog#1), for Logix IDE's new uart example.
  // Otherwise the same data as prod's 2026-11-11.
  "logix-catalog": {
    "repo": "openlogix/logix-catalog",
    "release": "2026-11-19",
    "file": "logix-catalog-${YYYYMMDD}.tgz"
  }
}
