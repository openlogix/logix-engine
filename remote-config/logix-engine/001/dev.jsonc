// What Logix Engine on config 001 uses on the dev channel (Remote updates, in
// the website repo's CLAUDE.md): every engine release that isn't promoted,
// and local builds, while this file exists; without it they use
// prod.jsonc. Every such engine reads this file from main, so a change here
// reaches them without an engine release, and never reaches prod. Change it
// only by pull request, saying why in a comment; the tests run with what it
// names. It may name pre-releases: a release a config names is kept. Delete
// it once a promotion has caught prod.jsonc up.
{
  "$schema": "https://www.openlogix.org/schemas/logix-remote-config-v1.json",

  // The FPGA tools: the YosysHQ OSS CAD Suite, openXC7, Verible and elkjs.
  // 2026-11-13: for Windows (Milestone 3): openXC7 runs with the suite's
  // yosys and Python, and verilator gets VERILATOR_ROOT (logix-core.json's
  // run.path and run.env).
  // 2026-11-14: the Windows package also has libwdi's wdi-simple, which
  // install_driver runs to install WinUSB (Milestone 3, drivers).
  "logix-core": {
    "repo": "openlogix/logix-core",
    "release": "2026-11-14",
    "file": "logix-core-${PLATFORM}-${YYYYMMDD}.tgz"
  },

  // The boards and FPGAs.
  // Pinned at the first promotion, 2026-11-13.
  "logix-catalog": {
    "repo": "openlogix/logix-catalog",
    "release": "2026-11-11",
    "file": "logix-catalog-${YYYYMMDD}.tgz"
  }
}
