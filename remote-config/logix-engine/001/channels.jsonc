// Logix Engine's release channels for config version 001 (Remote updates, in
// the website repo's CLAUDE.md). A release listed under a channel reads that
// channel's file here (prod.jsonc when it has none); every other release is on
// dev, the default, and local builds always are. Change it only by pull
// request: adding a release under prod promotes it (it must be stable first).
{
  "$schema": "https://www.openlogix.org/schemas/logix-channels-v1.json",

  // The first promotion, 2026-11-13.
  "prod": ["2026-11-12"]
}
